# ── Python ──────────────────────────────────────────────
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# ── Build / compile outputs (regenerated by CI) ─────────
hariku.build/
hariku.dist/
Output/
Output-update/
*.spec

# ── The official extensions and the servers ─────────────
# Their own repositories (hariku-extensions, hariku-servers), maintained
# privately by InfiArtt, checked out here for development. The extensions
# come to users from the Extension Store.
/extensions/
/servers/

# ── Local runtime / scratch / caches ────────────────────
scratchpad/
data/
mock_store/
store_release/
# Trivia data builds (extensions/_tools/build_trivia_*.py): partial downloads, the IndoMMLU pack
/build/

# ── Secrets & old-backend copy (NEVER publish) ──────────
# Full copy of the retired novarealm backend: DB dumps, connect.php creds, etc.
hariku.novarealm.cloud/
.env
*.env
settings/*.local.json

# ── Misc build artifacts ────────────────────────────────
Hariku_V2_Developer_SDK.zip
*.log

# ── Personal notes and retired files (kept locally, not part of the project) ──
/how-to.txt
/news.txt
/body.html
/sdk_release_post.md
/hariku_v2_journey.md
/hariku_v2_overview_post.md
